msgid "plugins.generic.ror.displayName"
msgstr "سجل منظمات البحث (ROR)"

msgid "plugins.generic.ror.description"
msgstr "يسمح بإدارة انتماءات المؤلفين/المراجعين باستخدام معرفات <a href=\"https://ror.org\">ROR</a>."

msgid "plugins.generic.ror.input.label"
msgstr "معرف ROR"

msgid "plugins.generic.ror.input.tooltip"
msgstr "ROR هو سجل عالمي يقوده المجتمع للمعرفات المستمرة المفتوحة لمنظمات البحث. تعرف على المزيد في <a href=\"https://ror.org\">ror.org</a>."

msgid "plugins.generic.ror.input.lookup.label"
msgstr "البحث عن الانتماء ومعرف ROR على ror.org"

msgid "plugins.generic.ror.input.lookup.tooltip"
msgstr "يرجى إدخال اسم المنظمة. سيؤدي النقر على المنظمة إلى استبدال حقول \"الانتماء\" و \"معرف ROR\"."
