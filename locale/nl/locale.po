msgid "plugins.generic.ror.displayName"
msgstr "Research Organization Registry (ROR)"

msgid "plugins.generic.ror.description"
msgstr "Maakt het mogelijk om auteurs-/reviewers-affiliaties te beheren met behulp van <a href=\"https://ror.org\">ROR</a>-identificatoren."

msgid "plugins.generic.ror.input.label"
msgstr "ROR iD"

msgid "plugins.generic.ror.input.tooltip"
msgstr "ROR is een wereldwijd, door de gemeenschap geleid register van open persistente identificatoren voor onderzoeksorganisaties. Meer informatie op <a href=\"https://ror.org\">ror.org</a>."

msgid "plugins.generic.ror.input.lookup.label"
msgstr "Zoek naar Affiliatie en ROR iD op ror.org"

msgid "plugins.generic.ror.input.lookup.tooltip"
msgstr "Vul de naam van de organisatie in. Door op de organisatie te klikken worden de velden \"Affiliatie\" en \"ROR iD\" overschreven."
