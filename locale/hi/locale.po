msgid "plugins.generic.ror.displayName"
msgstr "अनुसंधान संगठन रजिस्ट्री (ROR)"

msgid "plugins.generic.ror.description"
msgstr "<a href=\"https://ror.org\">ROR</a> पहचानकर्ताओं का उपयोग करके लेखक/समीक्षक संबद्धताओं को प्रबंधित करने की अनुमति देता है।"

msgid "plugins.generic.ror.input.label"
msgstr "ROR आईडी"

msgid "plugins.generic.ror.input.tooltip"
msgstr "ROR अनुसंधान संगठनों के लिए एक वैश्विक, समुदाय-नेतृत्व वाला खुला स्थायी पहचानकर्ताओं का रजिस्ट्री है। <a href=\"https://ror.org\">ror.org</a> पर अधिक जानें।"

msgid "plugins.generic.ror.input.lookup.label"
msgstr "ror.org पर संबद्धता और ROR आईडी खोजें"

msgid "plugins.generic.ror.input.lookup.tooltip"
msgstr "कृपया संगठन का नाम भरें। संगठन पर क्लिक करने से \"संबद्धता\" और \"ROR आईडी\" फ़ील्ड ओवरराइट हो जाएंगे।"
