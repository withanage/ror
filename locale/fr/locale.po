msgid "plugins.generic.ror.displayName"
msgstr "Registre des Organisations de Recherche (ROR)"

msgid "plugins.generic.ror.description"
msgstr "Permet de gérer les affiliations des auteurs/évaluateurs à l'aide des identifiants <a href=\"https://ror.org\">ROR</a>."

msgid "plugins.generic.ror.input.label"
msgstr "iD ROR"

msgid "plugins.generic.ror.input.tooltip"
msgstr "ROR est un registre mondial, dirigé par la communauté, d'identifiants persistants ouverts pour les organisations de recherche. En savoir plus sur <a href=\"https://ror.org\">ror.org</a>."

msgid "plugins.generic.ror.input.lookup.label"
msgstr "Rechercher une affiliation et un iD ROR sur ror.org"

msgid "plugins.generic.ror.input.lookup.tooltip"
msgstr "Veuillez saisir le nom de l'organisation. En cliquant sur l'organisation, les champs \"Affiliation\" et \"iD ROR\" seront remplacés."
