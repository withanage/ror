msgid "plugins.generic.ror.displayName"
msgstr "Rejestr Organizacji Badawczych (ROR)"

msgid "plugins.generic.ror.description"
msgstr "Umożliwia zarządzanie afiliacjami autorów/recenzentów za pomocą identyfikatorów <a href=\"https://ror.org\">ROR</a>."

msgid "plugins.generic.ror.input.label"
msgstr "ROR ID"

msgid "plugins.generic.ror.input.tooltip"
msgstr "ROR to globalny, prowadzony przez społeczność rejestr otwartych stałych identyfikatorów dla organizacji badawczych. Dowiedz się więcej na <a href=\"https://ror.org\">ror.org</a>."

msgid "plugins.generic.ror.input.lookup.label"
msgstr "Wyszukaj Afiliację i ROR ID na ror.org"

msgid "plugins.generic.ror.input.lookup.tooltip"
msgstr "Proszę wpisać nazwę organizacji. Kliknięcie na organizację spowoduje nadpisanie pól \"Afiliacja\" i \"ROR ID\"."
