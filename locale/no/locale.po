msgid "plugins.generic.ror.displayName"
msgstr "Research Organization Registry (ROR)"

msgid "plugins.generic.ror.description"
msgstr "Gjør det mulig å administrere forfatter-/fagfellevurderingstilknytninger ved hjelp av <a href=\"https://ror.org\">ROR</a>-identifikatorer."

msgid "plugins.generic.ror.input.label"
msgstr "ROR-ID"

msgid "plugins.generic.ror.input.tooltip"
msgstr "ROR er et globalt, fellesskapsledet register over åpne persistente identifikatorer for forskningsorganisasjoner. Lær mer på <a href=\"https://ror.org\">ror.org</a>."

msgid "plugins.generic.ror.input.lookup.label"
msgstr "Søk etter tilknytning og ROR-ID på ror.org"

msgid "plugins.generic.ror.input.lookup.tooltip"
msgstr "Vennligst fyll inn navnet på organisasjonen. Å klikke på organisasjonen vil overskrive feltene \"Tilknytning\" og \"ROR-ID\"."
