msgid "plugins.generic.ror.displayName"
msgstr "Araştırma Organizasyonları Kaydı (ROR)"

msgid "plugins.generic.ror.description"
msgstr "<a href=\"https://ror.org\">ROR</a> tanımlayıcılarını kullanarak yazar/hakem kurumlarını yönetmeyi sağlar."

msgid "plugins.generic.ror.input.label"
msgstr "ROR ID"

msgid "plugins.generic.ror.input.tooltip"
msgstr "ROR, araştırma kuruluşları için küresel, topluluk öncülüğünde bir açık kalıcı tanımlayıcı kaydıdır. <a href=\"https://ror.org\">ror.org</a> adresinde daha fazla bilgi edinebilirsiniz."

msgid "plugins.generic.ror.input.lookup.label"
msgstr "ror.org'da Kurum ve ROR ID Ara"

msgid "plugins.generic.ror.input.lookup.tooltip"
msgstr "Lütfen kuruluşun adını girin. Kuruluşa tıklamak, \"Kurum\" ve \"ROR ID\" alanlarını geçersiz kılacaktır."
