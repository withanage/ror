msgid "plugins.generic.ror.displayName"
msgstr "Tutkimusorganisaatiorekisteri (ROR)"

msgid "plugins.generic.ror.description"
msgstr "Mahdollistaa kirjoittajien/arvioijien affiliaatioiden hallinnoimisen <a href=\"https://ror.org\">ROR</a>-tunnisteiden avulla."

msgid "plugins.generic.ror.input.label"
msgstr "ROR-tunnus"

msgid "plugins.generic.ror.input.tooltip"
msgstr "ROR on maailmanlaajuinen, yhteisöjohtoinen avoimien pysyvien tunnisteiden rekisteri tutkimusorganisaatioille. Lue lisää osoitteessa <a href=\"https://ror.org\">ror.org</a>."

msgid "plugins.generic.ror.input.lookup.label"
msgstr "Etsi affiliaatiota ja ROR-tunnusta ror.org-sivustolta"

msgid "plugins.generic.ror.input.lookup.tooltip"
msgstr "Täytä organisaation nimi. Organisaation klikkaaminen korvaa kentät \"Affiliaatio\" ja \"ROR-tunnus\"."
