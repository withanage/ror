msgid "plugins.generic.ror.displayName"
msgstr "Research Organization Registry (ROR)"

msgid "plugins.generic.ror.description"
msgstr "Möjliggör hantering av författares/granskares tillhörigheter med hjälp av <a href=\"https://ror.org\">ROR</a>-identifierare."

msgid "plugins.generic.ror.input.label"
msgstr "ROR-ID"

msgid "plugins.generic.ror.input.tooltip"
msgstr "ROR är ett globalt, gemenskapsdrivet register över öppna beständiga identifierare för forskningsorganisationer. Läs mer på <a href=\"https://ror.org\">ror.org</a>."

msgid "plugins.generic.ror.input.lookup.label"
msgstr "Sök efter tillhörighet och ROR-ID på ror.org"

msgid "plugins.generic.ror.input.lookup.tooltip"
msgstr "Vänligen fyll i organisationens namn. Att klicka på organisationen kommer att skriva över fälten \"Tillhörighet\" och \"ROR-ID\"."
