msgid "plugins.generic.ror.displayName"
msgstr "Registro de Organizações de Pesquisa (ROR)"

msgid "plugins.generic.ror.description"
msgstr "Permite gerenciar afiliações de autores/revisores usando os identificadores <a href=\"https://ror.org\">ROR</a>."

msgid "plugins.generic.ror.input.label"
msgstr "ROR iD"

msgid "plugins.generic.ror.input.tooltip"
msgstr "ROR é um registro global, liderado pela comunidade, de identificadores persistentes abertos para organizações de pesquisa. Saiba mais em <a href=\"https://ror.org\">ror.org</a>."

msgid "plugins.generic.ror.input.lookup.label"
msgstr "Pesquisar Afiliação e ROR iD no ror.org"

msgid "plugins.generic.ror.input.lookup.tooltip"
msgstr "Por favor, preencha o nome da organização. Clicar na organização irá sobrescrever os campos \"Afiliação\" e \"ROR iD\"."
