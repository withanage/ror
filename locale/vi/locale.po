msgid "plugins.generic.ror.displayName"
msgstr "Cơ Quan Đăng Ký Tổ Chức Nghiên Cứu (ROR)"

msgid "plugins.generic.ror.description"
msgstr "Cho phép quản lý liên kết của tác giả/người đánh giá bằng cách sử dụng các định danh <a href=\"https://ror.org\">ROR</a>."

msgid "plugins.generic.ror.input.label"
msgstr "Định danh ROR"

msgid "plugins.generic.ror.input.tooltip"
msgstr "ROR là một cơ quan đăng ký toàn cầu, do cộng đồng lãnh đạo, về các định danh bền vững mở cho các tổ chức nghiên cứu. Tìm hiểu thêm tại <a href=\"https://ror.org\">ror.org</a>."

msgid "plugins.generic.ror.input.lookup.label"
msgstr "Tìm kiếm Liên kết và Định danh ROR trên ror.org"

msgid "plugins.generic.ror.input.lookup.tooltip"
msgstr "Vui lòng điền tên của tổ chức. Nhấp vào tổ chức sẽ ghi đè lên các trường \"Liên kết\" và \"Định danh ROR\"."
