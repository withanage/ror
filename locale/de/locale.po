msgid "plugins.generic.ror.displayName"
msgstr "Research Organization Registry (ROR)"

msgid "plugins.generic.ror.description"
msgstr "Ermöglicht die Verwaltung von Autor/Gutachter-Zugehörigkeiten mit <a href=\"https://ror.org\">ROR</a>-Kennungen."

msgid "plugins.generic.ror.input.label"
msgstr "ROR-iD"

msgid "plugins.generic.ror.input.tooltip"
msgstr "ROR ist ein globales, von der Gemeinschaft geführtes Register offener persistenter Identifikatoren für Forschungsorganisationen. Erfahren Sie mehr unter <a href=\"https://ror.org\">ror.org</a>."

msgid "plugins.generic.ror.input.lookup.label"
msgstr "Suche nach Zugehörigkeit und ROR-iD auf ror.org"

msgid "plugins.generic.ror.input.lookup.tooltip"
msgstr "Bitte geben Sie den Namen der Organisation ein. Durch Klicken auf die Organisation werden die Felder \"Zugehörigkeit\" und \"ROR-iD\" überschrieben."
