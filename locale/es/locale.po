msgid "plugins.generic.ror.displayName"
msgstr "Registro de Organizaciones de Investigación (ROR)"

msgid "plugins.generic.ror.description"
msgstr "Permite gestionar afiliaciones de autores/revisores utilizando los identificadores <a href=\"https://ror.org\">ROR</a>."

msgid "plugins.generic.ror.input.label"
msgstr "iD ROR"

msgid "plugins.generic.ror.input.tooltip"
msgstr "ROR es un registro global, dirigido por la comunidad, de identificadores persistentes abiertos para organizaciones de investigación. Más información en <a href=\"https://ror.org\">ror.org</a>."

msgid "plugins.generic.ror.input.lookup.label"
msgstr "Buscar Afiliación e iD ROR en ror.org"

msgid "plugins.generic.ror.input.lookup.tooltip"
msgstr "Por favor, introduzca el nombre de la organización. Al hacer clic en la organización se sobrescribirán los campos \"Afiliación\" y \"iD ROR\"."
